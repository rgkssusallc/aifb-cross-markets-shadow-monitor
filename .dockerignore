# Keep the build context small and secrets out of the image.
.git
.gitignore
**/__pycache__
**/*.pyc
.venv
venv

# Runtime output. These are produced by a RUN, not inputs to a build: copying a
# local monitor.db into the image would ship someone else's measurements as if
# they were this container's.
*.db
*.db-wal
*.db-shm
*.jsonl
status.json
screen_result.json
data

# Never bake credentials into a layer.
.env
*.env
!docker/.env.example
