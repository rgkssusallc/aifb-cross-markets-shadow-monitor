# Copy to docker/.env and edit. docker/.env is gitignored -- keep it that way.
#
#   cp docker/.env.example docker/.env

# ---------------------------------------------------------------------------
# Chain endpoints -- EVM_BASE_RPC_URL IS REQUIRED
# ---------------------------------------------------------------------------
# Every candidate in candidates.py trades on Base, so without a Base endpoint
# nothing can be quoted: the monitor refuses every venue and exits with "no
# pair had two usable venues". The container fails fast with a clear message
# rather than letting that look like a quiet market.
#
# Any Base JSON-RPC endpoint works. The public one is rate-limited and fine to
# start with; a provider endpoint is better for a continuous run, because the
# monitor polls once a second.
#   https://mainnet.base.org                    (public, rate-limited)
#   https://base-mainnet.g.alchemy.com/v2/KEY   (provider)
EVM_BASE_RPC_URL=https://mainnet.base.org

# Optional. Only WETH uses Arbitrum, where its best route is often
# Base<->Arbitrum rather than Coinbase<->Base. Leave blank and that venue
# refuses itself, which is designed behaviour and not an error.
#   https://arb1.arbitrum.io/rpc
EVM_ARB_RPC_URL=

# Optional. Needed only for the SUI-USDC pair, which is not in the top 10.
#   https://fullnode.mainnet.sui.io:443
NON_EVM_SUI_RPC_URL=

# Optional last-resort fallback for any chain with no variable of its own.
# Prefer the per-chain variables: one stale generic endpoint serving every
# chain is exactly the wrong-network failure the code checks chain ids to
# catch.
EVM_RPC_URL=

# ---------------------------------------------------------------------------
# Webhook: where the monitor pushes open/close/heartbeat/summary/arbfeedall.
# ---------------------------------------------------------------------------
# IMPORTANT: inside a container, localhost is the CONTAINER, not your machine.
# Point this at host.docker.internal to reach a frontend running on your host.
# Getting this wrong is the usual reason a local deployment delivers nothing
# while looking perfectly healthy.
#
#   your app on host port 3000  ->  http://host.docker.internal:3000/api/arb
#   another compose service     ->  http://<service-name>:<port>/api/arb
#   leave blank                 ->  no webhook; events land in the volume only
SHADOW_WEBHOOK_URL=

# Shared secret, sent as the X-Shadow-Token header. Your endpoint should
# reject anything without it: once reachable, an unauthenticated endpoint
# accepts fabricated opportunities from anybody who finds it.
#
# Generate your own and do not paste it into a chat or a commit:
#   openssl rand -hex 32
SHADOW_WEBHOOK_SECRET=

# 1 = refuse to start if the webhook preflight fails. Recommended once the
# endpoint is live, because an endpoint that was never reachable looks exactly
# like a quiet market.
SHADOW_REQUIRE_WEBHOOK=0

# ---------------------------------------------------------------------------
# What to measure
# ---------------------------------------------------------------------------
# The measured top N candidates from candidates.py (`python candidates.py`
# prints the table and the evidence).
SHADOW_CANDIDATES=10

# Explicit override; takes precedence over SHADOW_CANDIDATES when set.
#   SHADOW_PAIRS=WETH-USDC,AERO-USDC,LINK-USDC
SHADOW_PAIRS=

# Probe notional in USD. Edge is size-dependent -- every bps figure the
# monitor reports is only true at this size, and most candidate pools cannot
# absorb much more than $1,000.
SHADOW_SIZE_USD=1000

# ---------------------------------------------------------------------------
# Cadence
# ---------------------------------------------------------------------------
# 1.0s is deliberate: a leg needs two quotes at roughly 500ms each, so
# spinning faster buys nothing against the upstream.
SHADOW_INTERVAL_S=1.0
SHADOW_HEARTBEAT_S=5
SHADOW_SUMMARY_S=60
SHADOW_FEED_S=15

# How long one run lasts before the process exits. The default is a year, i.e.
# "until stopped" -- restart:unless-stopped handles a real crash. Lower it only
# for a bounded experiment.
# SHADOW_SECONDS=31536000
